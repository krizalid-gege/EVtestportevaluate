# Database Configuration (Supports Local PostgreSQL or Remote CodeArts / Huawei Cloud / Alibaba Cloud RDS)
# Local example: postgresql://postgres:postgres@127.0.0.1:5432/ev_cpo_dev?schema=public
# Cloud example: postgresql://ev_user:your_password@your-cloud-host:5432/ev_cpo_dev?schema=public
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/ev_cpo_dev?schema=public"

# Application URLs & Ports
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_OCPP_WS_URL="ws://localhost:9000"
OCPP_PORT=9000
OCPP_INTERNAL_PORT=9001
OCPP_INTERNAL_HOST="127.0.0.1"
INTERNAL_SECRET="change-me-in-production"

# Auth & Security
JWT_SECRET="change-me-in-production"

# Phase 1A Demo & Regional Settings
DEMO_MODE="true"
DEFAULT_TIMEZONE="Asia/Kuala_Lumpur"
DEFAULT_CURRENCY="MYR"

# Optional SMTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@evcpo-demo.my"
